{
  "name": "eip-7702",
  "main": "worker.ts",
  "account_id": "94540d71e20e27bc2f813bbd79ced3e1",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "eip7702.io/*", "zone_name": "eip7702.io" }],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/reference", "/examples", "/ecosystem"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
